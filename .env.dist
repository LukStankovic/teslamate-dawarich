# Required
DAWARICH_URL=http://dawarich_app:3000
DAWARICH_API_KEY=
# Set to https when Dawarich runs with APPLICATION_PROTOCOL=https and you reach
# it over internal HTTP.
DAWARICH_FORWARDED_PROTO=
TESLAMATE_DB_URL=postgres://teslamate:password@database:5432/teslamate

# Sync behaviour
POLL_INTERVAL=15s      # upper bound on latency; MQTT_HOST makes it near-instant
OVERLAP_WINDOW=5m      # re-read window that closes late-commit gaps
INITIAL_LOOKBACK=24h   # how far back the very first run starts
BATCH_SIZE=1000        # points per Dawarich request
DRIVES_ONLY=true       # false also syncs parked and charging positions
CAR_IDS=               # empty means all cars
TRACKER_PREFIX=tesla-  # prepended to the TeslaMate car name

# Optional: MQTT nudging. Set MQTT_HOST to poll the moment TeslaMate publishes.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=teslamate-dawarich
MQTT_TLS=false
MQTT_NAMESPACE=

LOG_LEVEL=info
